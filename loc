#!/bin/bash
# loc - OpenCode Remote Control Wrapper
#
# 包装 opencode 命令，启动 tmux 会话并通过 daemon 注册远程控制。
# OpenCode 的状态从 sqlite 读（~/.local/share/opencode/opencode.db），无需日志捕获。
# 安装: sudo cp loc /usr/local/bin/loc && chmod +x /usr/local/bin/loc
#
# 使用:
#   loc                    # 启动后台 opencode 会话（可 tmux attach -t claude-<id> 附接查看）
#   loc --foreground       # 在当前终端启动（等同直接运行 opencode）
#   loc --name "论文搜索"  # 指定会话名称
#   loc --help             # 显示帮助

set -euo pipefail

# ── 配置 ──────────────────────────────────────────────
DAEMON_URL="${CCR_DAEMON_URL:-http://localhost:9998}"
UUID="${CCR_SESSION_ID:-$(uuidgen | tr '[:upper:]' '[:lower:]')}"
# tmux 会话名沿用 claude- 前缀：daemon 的 handle_register_session 与
# screen_mgr._session_name 都按 claude-<id[:12]> 派生，此处必须一致才能被 send_keys 命中
TMUX_NAME="claude-${UUID:0:12}"
CWD="$(pwd)"
SESSION_NAME=""

# ── 解析参数 ──────────────────────────────────────────
FOREGROUND=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --foreground|-f)
            FOREGROUND=true
            shift
            ;;
        --name|-n)
            SESSION_NAME="$2"
            shift 2
            ;;
        --help|-h)
            echo "loc - OpenCode Remote Control Wrapper"
            echo ""
            echo "用法: loc [选项] -- [opencode 参数...]"
            echo ""
            echo "选项:"
            echo "  --foreground, -f    在前台运行（等同直接运行 opencode）"
            echo "  --name, -n <名称>   设置会话名称"
            echo "  --help, -h          显示此帮助"
            echo ""
            echo "环境变量:"
            echo "  CCR_DAEMON_URL      Daemon 地址 (默认: http://localhost:9998)"
            echo "  CCR_SESSION_ID      手动指定 session ID（默认自动生成）"
            echo ""
            echo "后台模式: tmux attach -t claude-<id> 可附接查看"
            echo ""
            echo "示例:"
            echo "  loc                          # 启动后台 opencode"
            echo "  loc --name 论文搜索           # 带名称启动"
            echo "  loc --foreground              # 前台运行"
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

# ── 注册 session 到 daemon ──────────────────────────
register_session() {
    local name="${SESSION_NAME:-$(basename "$CWD")}"
    curl -s -X POST "${DAEMON_URL}/api/session/register" \
        -H "Content-Type: application/json" \
        -d "{\"id\":\"${UUID}\",\"name\":\"${name}\",\"cwd\":\"${CWD}\",\"pid\":$$,\"session_type\":\"screen\",\"agent\":\"opencode\"}" \
        > /dev/null 2>&1 || true
}

# ── 心跳循环（后台模式使用） ──────────────────────
heartbeat_loop() {
    # 等待 tmux 会话启动
    sleep 1
    while true; do
        # 检查 tmux 会话是否存在
        if ! tmux has-session -t "${TMUX_NAME}" 2>/dev/null; then
            break
        fi
        # 发送心跳
        curl -s -X PUT "${DAEMON_URL}/api/session/${UUID}/heartbeat" \
            -H "Content-Type: application/json" \
            -d "{\"pid\":$$}" > /dev/null 2>&1 || true
        sleep 5
    done
    # 会话结束，通知 daemon
    curl -s -X DELETE "${DAEMON_URL}/api/session/${UUID}" > /dev/null 2>&1 || true
}

# ── 清理 ────────────────────────────────────────────
cleanup() {
    curl -s -X DELETE "${DAEMON_URL}/api/session/${UUID}" > /dev/null 2>&1 || true
}
trap cleanup EXIT

# ── 启动 ────────────────────────────────────────────
register_session

if $FOREGROUND; then
    # 前台模式：直接在当前终端运行 opencode（不建 tmux 会话）
    echo "loc: Starting opencode (foreground mode) — session: ${UUID:0:8}"
    # 退出时由 trap cleanup 注销 session
    opencode "$@"
else
    # 后台模式：创建 detached tmux 会话
    # 不用 script 捕获日志：opencode 是 TUI，捕获出来是 ANSI 乱码；
    # 状态/输出由 daemon 从 sqlite 读
    echo "loc: Starting opencode in tmux session: ${TMUX_NAME}"
    echo "     Attach: tmux attach -t ${TMUX_NAME}"
    echo "     Session ID: ${UUID:0:8}"

    tmux new-session -d -s "${TMUX_NAME}" \
        "cd '${CWD}' && opencode $*"

    # 心跳循环（阻塞，直到 tmux 会话退出）
    heartbeat_loop
fi
